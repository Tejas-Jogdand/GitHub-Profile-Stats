{
  "name": "readme-stat-generator",
  "version": "1.0.0",
  "description": "Personal GitHub stats and streak SVG card generator",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:mock": "tsx src/index.ts --mock",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "github",
    "stats",
    "svg",
    "streak",
    "readme"
  ],
  "author": "Tejas Jogdand",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "octokit": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
