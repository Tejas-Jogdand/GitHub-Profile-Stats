# GitHub Personal Access Token
# For public stats: A token with 'read:user' scope.
# To include private contributions and private repositories: A token with 'repo' and 'read:user' scopes.
# (Fine-grained PAT: Contents: Read, Metadata: Read, User profile: Read)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# GitHub username to generate stats for (optional: defaults to the token owner if left blank)
GITHUB_USERNAME=your-github-username

# Directory where generated SVG cards will be saved
OUTPUT_DIR=./generated

# Whether to fetch multi-year historical data for an all-time contribution streak (true/false)
FETCH_MULTI_YEAR=true

# Visual theme for the SVG cards (default: github-dark)
# Options: github-dark, tokyo-night, dracula, minimal-light
CARD_THEME=github-dark

# User timezone (e.g., UTC, Asia/Kolkata, America/New_York)
# Used to accurately compute streak boundaries around midnight
TIMEZONE=UTC
